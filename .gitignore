# Logs
debug.log

# Tmux plugins (managed by tpm)
tmux/.config/tmux/plugins/
.config/homebrew/trust.json.lock

# App-generated state (~/.config is a symlink to .config in this repo, so apps
# write their runtime files straight into the working tree)
.config/1Password/

# herdr's registry of linked plugins, which records absolute paths for this
# machine. The plugins themselves live in .config/herdr/plugins/ and are
# tracked; `herdr plugin link` rebuilds this file.
.config/herdr/plugins.json
.config/herdr/.plugins.lock

# herdr's runtime state: the live workspace layout and the client and server
# logs. All three are specific to one machine's running session.
.config/herdr/session.json
.config/herdr/*.log
