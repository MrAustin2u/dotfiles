{
  "permissions": {
    "allow": [
      "Bash(GH_PAGER=\"\" gh pr create --fill --base develop)",
      "Bash(MIX_ENV=test mix test:*)",
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(curl:*)",
      "Bash(elixir --version:*)",
      "Bash(elixir:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow run:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git remote get-url:*)",
      "Bash(git rm:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(grep:*)",
      "Bash(just:*)",
      "Bash(mix compile:*)",
      "Bash(mix format)",
      "Bash(mix format:*)",
      "Bash(mix help:*)",
      "Bash(mix run:*)",
      "Bash(mix test:*)",
      "Bash(mix xref:*)",
      "Bash(npm test:*)",
      "Bash(open:*)",
      "Bash(perl -i -pe:*)",
      "Bash(python3:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(xargs ls:*)",
      "Bash(xxd:*)",
      "Bash(ddcli-llm *)",
      "Bash(ddcli *)",
      "WebSearch"
    ]
  },
  "model": "claude-opus-4-8[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude is ready for input\" with title \"Claude Code\"'"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude needs your permission\" with title \"Claude Code\"'"
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.span/bin/hook-dispatcher ] && ~/.span/bin/hook-dispatcher claude postToolUseEvents || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.span/bin/hook-dispatcher ] && ~/.span/bin/hook-dispatcher claude postToolUseFailureEvents || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.span/bin/hook-dispatcher ] && ~/.span/bin/hook-dispatcher claude preCompactEventsEnhanced || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.span/bin/hook-dispatcher ] && ~/.span/bin/hook-dispatcher claude preToolUseEvents || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.span/bin/hook-dispatcher ] && ~/.span/bin/hook-dispatcher claude sessionEndEvents || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.span/bin/hook-dispatcher ] && ~/.span/bin/hook-dispatcher claude stopEventsEnhanced || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.span/bin/hook-dispatcher ] && ~/.span/bin/hook-dispatcher claude subagentStartEvents || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.span/bin/hook-dispatcher ] && ~/.span/bin/hook-dispatcher claude subagentStopEvents || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.span/bin/hook-dispatcher ] && ~/.span/bin/hook-dispatcher claude userPromptSubmitEvents || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "blvd-reliability@blvd-ai-tools": true,
    "elixir-phoenix-guide@elixir-phoenix-guide": true,
    "sentry@claude-plugins-official": true,
    "blvd-datadog@blvd-ai-tools": true,
    "elixir-dexter-lsp@blvd-ai-tools": true,
    "frontend-design@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
