#!/usr/bin/env zsh
# Gives a newly created worktree a .env, from the primary checkout's file when
# there is one and from .env.default otherwise.
#
# Copied rather than symlinked: a worktree may need its own values (a different
# port, a different queue prefix), and editing a symlink would rewrite the
# primary checkout's file. An existing .env in the destination is left alone.
#
# herdr runs event hooks asynchronously, so a pane's startup command can begin
# before this finishes. Nothing here is safe to depend on at pane start.
set -euo pipefail

herdr_bin="${HERDR_BIN_PATH:-herdr}"

notify() {
  "$herdr_bin" notification show "$1" --body "$2" >/dev/null 2>&1 || true
}

event_value() {
  [[ -n "${HERDR_PLUGIN_EVENT_JSON:-}" ]] || return 0
  jq -er "$1 // empty" <<<"$HERDR_PLUGIN_EVENT_JSON" 2>/dev/null || true
}

checkout="$(event_value '.worktree.path')"

if [[ -z "$checkout" || ! -d "$checkout" ]]; then
  notify "Copy .env skipped" "Could not determine the new worktree's path"
  exit 1
fi

# Copying onto the primary checkout would overwrite the source with itself.
if [[ "$(event_value '.worktree.is_linked_worktree')" != true ]]; then
  exit 0
fi

repo_root="$(event_value '.workspace.worktree.repo_root')"

# git knows where the primary checkout is even when the event payload does not:
# --git-common-dir resolves to that checkout's .git, unlike --git-dir.
if [[ -z "$repo_root" ]]; then
  common_dir="$(git -C "$checkout" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  [[ -n "$common_dir" ]] && repo_root="${common_dir:h}"
fi

if [[ -z "$repo_root" || "$repo_root" == "$checkout" ]]; then
  exit 0
fi

target_env="$checkout/.env"

# A worktree that already has a .env keeps it.
[[ -e "$target_env" ]] && exit 0

# .env.default is the file repos commit; .env is gitignored and each person
# creates their own. So a repo with a .env.default needs a .env even when the
# primary checkout has none, and the defaults are the only thing left to seed
# from. Prefer the worktree's own copy, which matches the branch checked out
# there and may list keys the primary checkout's copy does not.
default_env="$checkout/.env.default"
[[ -f "$default_env" ]] || default_env="$repo_root/.env.default"

if [[ -f "$repo_root/.env" ]]; then
  seed="$repo_root/.env"
elif [[ -f "$default_env" ]]; then
  seed="$default_env"
else
  exit 0
fi

if ! cp "$seed" "$target_env" 2>/dev/null; then
  notify "Copy .env failed" "Could not write $target_env"
  exit 1
fi

if [[ "$seed" == "$default_env" ]]; then
  notify "Created .env from .env.default" "Fill in values in $(basename "$checkout")"
else
  notify "Copied .env" "$(basename "$repo_root") → $(basename "$checkout")"
fi
