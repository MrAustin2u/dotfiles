# vim: ft=conf

# Appearance
macos-titlebar-style = tabs
theme = TokyoNight Moon
background-opacity = 0.85
background-blur-radius = 20
window-decoration = true
window-padding-x = 15
window-padding-y = 15

font-size = 17
adjust-cell-height = 10
font-family = MonoLisa

macos-titlebar-proxy-icon = hidden
title = "Ghostty"
desktop-notifications = true

# enable cursor animation
custom-shader = "~/.config/ghostty/shaders/cursor.glsl"
custom-shader-animation = true

# Keybinds
keybind = super+shift+r=reload_config

# Command-key shortcuts for herdr actions. Each sends \x1a, which is Ctrl+Z and
# the prefix set in .config/herdr/config.toml, followed by the action's key.
#
# Keep these comments on their own lines. Ghostty folds a trailing comment into
# the text a `text:` binding sends, so `text:\x1av # split` would type the
# comment into the pane.

# split right
keybind = super+d=text:\x1av
# workspace picker
keybind = super+shift+d=text:\x1aw
# close pane
keybind = super+w=text:\x1ax
# previous tab
keybind = super+shift+o=text:\x1ap
# next tab
keybind = super+shift+p=text:\x1an
# zoom pane
keybind = ctrl+`=text:\x1az

# Pane resizing is deliberately absent. It used to sit on super+shift+h/j/k/l as
# tmux resize-pane commands; the seamless-navigation herdr plugin now handles it
# on alt+h/j/k/l, which reaches herdr directly and needs no Ghostty binding.
#
# ctrl+[ is also absent. It sent tmux copy-mode, and binding it here stopped the
# key reaching herdr at all.

keybind = super+k=text:\x63\x6C\x65\x61\x72\x0A
keybind = ctrl+v=new_split:down
keybind = super+t=new_tab

# Shell
shell-integration = zsh

# Misc
macos-option-as-alt = true
mouse-hide-while-typing = true
desktop-notifications = true


# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95
